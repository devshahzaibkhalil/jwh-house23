# Copy this file to .env and replace the placeholder values.
# Never upload your real .env file to GitHub or send it to other people.

FLASK_ENV=development
SECRET_KEY=replace-with-a-long-random-secret

# Email address(es) that receive every new lead.
# Multiple addresses may be separated with commas.
OWNER_EMAIL=yourdestination@gmail.com

# --- Email delivery ---------------------------------------------------------
# Mail is sent over an HTTPS provider API, never SMTP, because Render blocks
# outbound SMTP ports (25/465/587).
#
# Mailjet is the default: it verifies a single SENDER ADDRESS by emailing a
# confirmation link to it, needs no domain DNS access, and its signup does not
# require a phone number.
#   1. Sign up at https://www.mailjet.com (Free plan, 6000 emails/month).
#   2. Senders & Domains -> Add a sender address. Enter the address mail should
#      come FROM, then click the confirmation link sent to that inbox.
#   3. Account Settings -> API Key Management. Mailjet issues TWO values, an
#      API Key and a Secret Key. Both are required.
#
# Do NOT wrap any of these values in quotes.
MAIL_PROVIDER=mailjet
MAILJET_API_KEY=replace-with-your-mailjet-api-key
MAILJET_SECRET_KEY=replace-with-your-mailjet-secret-key
MAIL_DEFAULT_SENDER=the-address-you-verified@gmail.com
MAIL_SENDER_NAME=James Wholesale Homes
MAIL_TIMEOUT=20

# Alternative providers, all single-sender and DNS-free. To use one instead,
# set MAIL_PROVIDER to its name and fill in its key(s). See EMAIL_SETUP.txt.
# SMTP2GO_API_KEY=            # MAIL_PROVIDER=smtp2go (key starts with "api-")
# BREVO_API_KEY=              # MAIL_PROVIDER=brevo
# SENDGRID_API_KEY=           # MAIL_PROVIDER=sendgrid

# Used in lead notification emails. Replace after deploying online.
ADMIN_BASE_URL=http://127.0.0.1:5000

# Development-only setting. Change to 0 when real email verification is ready.
SHOW_DEV_OTP=1
