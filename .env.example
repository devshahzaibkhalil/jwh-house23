# Copy this file to .env and replace the placeholder values.
# Never upload your real .env file to GitHub or send it to other people.

FLASK_ENV=development
SECRET_KEY=replace-with-a-long-random-secret

# Email address(es) that receive every new lead.
# Multiple addresses may be separated with commas.
OWNER_EMAIL=yourdestination@gmail.com

# Email is sent via the Resend HTTPS API instead of SMTP, because Render
# blocks outbound SMTP ports (25/465/587). Create a key at
# https://resend.com/api-keys and verify your sending domain there first.
RESEND_API_KEY=re_replace_with_your_resend_api_key
MAIL_DEFAULT_SENDER=noreply@yourdomain.com
MAIL_SENDER_NAME=James Wholesale Homes
MAIL_TIMEOUT=20

# Used in lead notification emails. Replace after deploying online.
ADMIN_BASE_URL=http://127.0.0.1:5000

# Development-only setting. Change to 0 when real email verification is ready.
SHOW_DEV_OTP=1
